{
  "name": "react-submit-flow",
  "version": "0.1.1",
  "description": "Typed async action flows with accessible, customizable React feedback.",
  "homepage": "https://mhmod-hsn.github.io/react-submit-flow/",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/types/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/forest.css": "./dist/themes/forest.css",
    "./themes/high-contrast.css": "./dist/themes/high-contrast.css"
  },
  "scripts": {
    "dev": "vp build --watch",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && vp build && node scripts/copy-css.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp lint src",
    "test": "echo 'Tests are not configured yet.'",
    "check:package": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
